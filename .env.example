# ============================================================
# MediKiosk — Environment Variables Template
# Copy this file to .env.local for local development.
# On Vercel / Render, add these variables in your Project Settings.
# ============================================================

# ── Supabase (Database & Authentication) ───────────────────
# Required for patient database, clinical sessions, and auth.
# Find at: https://app.supabase.com/ → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Google Gemini AI ─────────────────────────────────────────
# Used for multimodal medical intake, document OCR reasoning, and clinical insights.
# Get an API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# ── Groq (Clinical Summarization) ───────────────────────────
# Ultra-low latency Llama 3.1 clinical summary & SOAP generation.
# Get an API key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# ── Bhashini (AI4Bharat Multilingual Voice) ─────────────────
# National language translation, speech-to-text (ASR), and text-to-speech (TTS).
# Get keys from: https://auth.bhashini.gov.in/
BHASHINI_API_KEY=your_bhashini_api_key_here
BHASHINI_ENDPOINT=https://meity-auth.ulcacontrib.in

# ── ABDM / NDHM (Ayushman Bharat Digital Mission) ────────────
# National Health Authority Sandbox credentials for ABHA verification.
# Portal: https://sandbox.abdm.gov.in/
ABDM_CLIENT_ID=your_abdm_client_id_here
ABDM_CLIENT_SECRET=your_abdm_client_secret_here
ABDM_BASE_URL=https://abhasandbox.abdm.gov.in

# ── PaddleOCR (Document Scanning) ────────────────────────────
# Optical Character Recognition for physical doctor prescriptions & lab reports.
PADDLEOCR_API_KEY=your_paddleocr_api_key_here

# ── Security & Admin Route ──────────────────────────────────
# Secret passphrase protecting the /admin dashboard route.
ADMIN_SECRET=generate_a_secure_random_string_here

# ── Optional: Hospital Information System (HIS) Integration ─
# NEXT_PUBLIC_HIS_API_URL=https://his.hospital.org/api/v1
